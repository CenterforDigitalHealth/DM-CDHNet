# Source-only repository: ignore new files unless explicitly allowed below.
# Works when this directory is the Git root, without the parent .gitignore.
*
!*/

# Keep repository instructions and this publication policy.
!/.gitignore
!/README.md

# Source code and notebooks. Notebook cell outputs must be cleared before commit;
# .gitignore cannot distinguish code cells from outputs inside an .ipynb file.
!*.py
!*.ipynb
!*.sh
!*.R
!*.r
!*.sql
*.ttf

# Project documentation, dependencies and configuration.
AGENTS.md
LICENSE
LICENSE.*
requirements-analysis.txt
evaluation_policy.json

# python scripts
prepare_temporal.py
project_paths.py
initialize.py
data.py
demo.py
report.py

# Generated folders stay excluded even if they contain Python, notebooks or docs.
outputs/
output/
results/
result/
reports/
report/
checkpoints/
checkpoint/
provenance/
scripts/
weights/
legacy/
logs/
runs/
analysis/
assets/
docs/
data/
figures/
figutil/
figdata/
tests/
tmp/
temp/
cache/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
node_modules/
build/
dist/
*.egg-info/
